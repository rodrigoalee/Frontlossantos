# URL base de CustomCore.API
# Local: http://localhost:5239 (perfil "http" de launchSettings.json)
# Producción (Vercel): la URL pública HTTPS de la API, nunca localhost
API_URL=http://localhost:5239

# Google OAuth (Google Cloud Console > APIs y servicios > Credenciales)
# URI de redirección autorizada: <URL de la app>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Power BI: enlace de "Publicar en la web" del reporte de analíticas
# (Archivo > Insertar informe > Publicar en la web > copiar el enlace https://app.powerbi.com/view?r=...)
POWERBI_URL_REPORTE=

# Vercel Blob: fotos del diagnóstico de las órdenes
# En Vercel no hace falta: al conectar el store público, Vercel agrega BLOB_STORE_ID y se autentica solo (OIDC).
# En local sí: copiarla de Vercel > Storage > el store > pestaña .env.local.
BLOB_READ_WRITE_TOKEN=
