# URL base de CustomCore.API
# Local: http://localhost:5239 (perfil "http" de launchSettings.json)
# Producción (Vercel): la URL pública HTTPS de la API, nunca localhost
API_URL=http://localhost:5239

# Google OAuth (Google Cloud Console > APIs y servicios > Credenciales)
# URI de redirección autorizada: <URL de la app>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
